# 後端設定範例。複製成 .env 後修改（.env 不進版控）：cp .env.example .env
# npm start／npm run dev 會自動讀 .env；已經存在的環境變數優先。
# 標「必填」的沒給就不會啟動，並列出缺哪些。

# ── 必填 ────────────────────────────────────────────────────────
# 用 das_app 角色連線（只能 EXECUTE api.*）。
DATABASE_URL=postgres://das_app:das_app@127.0.0.1:5432/das
PORT=3000
# 至少 32 個字元。產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 輪替金鑰時用逗號分隔：新的放前面（用來簽），舊的放後面（只用來驗）。
SESSION_SECRET=change-me-change-me-change-me-change-me
# dev＝開發用登入（POST /api/auth/dev-login）；oidc＝公司 SSO。正式環境禁止 dev。
AUTH_MODE=dev
# console＝只寫 log 不寄信；smtp＝透過 SMTP_URL 寄。
MAIL_MODE=console
# mock＝依規則 JSON 算出驗證結果；manual＝本站不碰 DC，由 MIS 手動處理。
DC_MODE=mock
# dev＝固定驗證碼（MFA_DEV_CODE）；totp＝RFC 6238。正式環境禁止 dev。
MFA_MODE=dev
# 每隔幾秒呼叫一次 api.run_scheduled_jobs。
SCHEDULER_INTERVAL_SEC=60

# ── 選填（等號右邊是預設值）─────────────────────────────────────
# NODE_ENV=development          # development｜test｜production
# HOST=0.0.0.0
# LOG_LEVEL=info                # fatal｜error｜warn｜info｜debug｜trace｜silent
# API_PREFIX=/api               # 所有 API 的路徑前綴；/healthz 另外固定在根目錄
# WEB_DIST=                     # 前端 build 產物目錄（例：../web/dist）；有設才由後端提供靜態檔
# TRUST_PROXY=false             # 在反向代理後面時設 true、跳數（1）或代理的 IP/CIDR，才能取得真正的用戶端 IP
# PUBLIC_ORIGIN=                # 對外網址（例：https://das.example.com）；設了之後 CSRF 以它為準
# ALLOWED_ORIGINS=              # 額外允許的 Origin，逗號分隔（開發時前端 dev server 用）
# BODY_LIMIT_BYTES=1048576
# CONTENT_SECURITY_POLICY=      # 要覆寫預設的 CSP 時才設

# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000

# SESSION_TTL_SEC=28800         # 登入後最長多久要重新登入（8 小時）
# SESSION_IDLE_SEC=1800         # 多久沒有活動就登出（30 分鐘）
# COOKIE_SECURE=false           # 正式環境預設 true
# COOKIE_NAME=das_session       # COOKIE_SECURE=true 時預設 __Host-das_session

# MFA_TTL_SEC=300               # MFA step-up 有效幾秒
# MFA_DEV_CODE=000000

# RATE_LIMIT_MAX=30             # 登入與 MFA：每個 IP 在一個視窗內最多幾次（很多人共用同一個出口 IP 時要調高）
# RATE_LIMIT_WINDOW_SEC=60

# SCHEDULER_ENABLED=true        # false＝這個實例不跑排程
# OUTBOX_ENABLED=true           # false＝這個實例不寄信
# OUTBOX_INTERVAL_SEC=5
# OUTBOX_BATCH_SIZE=20
# OUTBOX_RETRY_BASE_SEC=60      # 寄信失敗後第一次重試的間隔，之後每次加倍
# OUTBOX_RETRY_MAX_SEC=21600    # 重試間隔上限（6 小時）

# ── AUTH_MODE=oidc ──────────────────────────────────────────────
# 四個都要有（OIDC_REDIRECT_URI 可由 PUBLIC_ORIGIN 推出）；不齊全時後端照常啟動，但 SSO 登入不啟用。
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://das.example.com/api/auth/oidc/callback
# OIDC_SCOPE=openid profile email

# ── MAIL_MODE=smtp（兩個都必填）─────────────────────────────────
# SMTP_URL=smtp://user:pass@mail.example.com:587
# MAIL_FROM=資料授權簽核 <das@example.com>

# ── 匯入用（npm run sync -- directory｜catalog）──────────────────
# DIRECTORY_FILE=               # 人員與組織資料的 JSON 檔
# CATALOG_FILE=                 # 資料目錄的 JSON 檔
