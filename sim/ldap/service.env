# sim/ldap 的非機密設定（唯一來源）。腳本、sim/idp 與測試都讀這個檔，不另外寫死。
SIM_LDAP_HOST=127.0.0.1
SIM_LDAP_PORT=3890
SIM_LDAP_URL="ldap://${SIM_LDAP_HOST}:${SIM_LDAP_PORT}"
SIM_LDAP_BASE_DN=dc=sim,dc=example
SIM_LDAP_PEOPLE_DN="ou=people,${SIM_LDAP_BASE_DN}"
SIM_LDAP_GROUPS_DN="ou=groups,${SIM_LDAP_BASE_DN}"
SIM_LDAP_ORG_DN="ou=org,${SIM_LDAP_BASE_DN}"
SIM_LDAP_ADMIN_DN="cn=admin,${SIM_LDAP_BASE_DN}"
SIM_LDAP_READER_DN="cn=reader,ou=services,${SIM_LDAP_BASE_DN}"
SIM_LDAP_MAIL_DOMAIN=sim.example
