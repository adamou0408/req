# 實例 unit：平台的資料庫測試（sgn_test）專用的另一個外部系統，和 main（sgn_e2e）分開資料庫、角色、金鑰與信任清單，
# 兩個平台資料庫的單號都從 1 編起，也不會互相覆蓋或撤回（紅隊第四輪 高-3、推論 2）。只寫和 service.env 不同的值。
SIM_DC_PORT=7002
SIM_DC_DB=sim_dc_unit
SIM_DC_DB_MASKED=sim_dc_unit_masked
SIM_DC_SERVICE_ROLE=simdc_u_service
SIM_DC_ROLE_PREFIX=simdc_u_p_
SIM_DC_MASKED_ROLE_PREFIX=simdc_u_m_p_
SIM_DC_SANDBOX_ROLE=simdc_u_m_sandbox
