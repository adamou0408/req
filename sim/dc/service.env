# sim/dc 的非機密設定（唯一來源）。腳本、服務本身與測試都讀這個檔，不另外寫死。
# 這裡是主要實例（main：平台端對端用的 sgn_e2e 連這一個）的值；其他實例只在 instances/<實例>.env 改不同的部分。
# 密鑰（服務的資料庫密碼、呼叫方金鑰、回應證明的私鑰）不在 repo：每個實例第一次啟動時產生在 sim/.run/<實例>/keys/。
SIM_DC_HOST=127.0.0.1
SIM_DC_PORT=7001
# PostgreSQL 與整個開發環境共用；本服務只建立名稱以 sim_dc 開頭的資料庫、以 simdc_ 開頭的角色。
SIM_DC_PG_HOST=127.0.0.1
SIM_DC_PG_PORT=5432
# 正式資料（合成）與遮罩資料各一個資料庫；同一個行程同時服務兩者（路徑前綴 /v1 與 /masked/v1）。
SIM_DC_DB=sim_dc
SIM_DC_DB_MASKED=sim_dc_test
# 服務自己的登入角色：擁有資料表，可以建立被授權者角色（CREATEROLE），不是 superuser。每個實例一個。
SIM_DC_SERVICE_ROLE=simdc_service
# 每個被授權者一個資料庫角色：前綴 + principal_id（UUID 去掉連字號，或十進位整數）。
SIM_DC_ROLE_PREFIX=simdc_p_
SIM_DC_MASKED_ROLE_PREFIX=simdc_m_p_
# 遮罩環境的沙箱角色：可讀遮罩資料庫的全部資料，用來執行「簽核前的測試報告」的查詢。
SIM_DC_SANDBOX_ROLE=simdc_m_sandbox
# 本 DC 接受哪些受管系統的規則（規則的 rules[].system）；以空白分隔。
SIM_DC_SYSTEMS="dc hr_saas"
# 授權起迄與「今天」以這個時區判斷。
SIM_DC_TIMEZONE=Asia/Taipei
# 平台的交付通道代碼：平台簽的請求要指名這個通道（裁決 D81 (2)）。
SIM_DC_CHANNEL=dc
# 測試用的管理後門（/v1/admin/*）。只供 sim；設為 0 就關閉。
SIM_DC_ENABLE_BACKDOOR=1
