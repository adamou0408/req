# sim/idp 的非機密設定（唯一來源）。腳本、平台後端的開發設定與測試都讀這個檔，不另外寫死。
SIM_IDP_HOST=127.0.0.1
SIM_IDP_PORT=5556
SIM_IDP_ISSUER="http://${SIM_IDP_HOST}:${SIM_IDP_PORT}/dex"
# 預先登記的 client：平台後端。redirect URI 以空白分隔。
SIM_IDP_CLIENT_ID=sgn-api
SIM_IDP_CLIENT_REDIRECT_URIS="http://127.0.0.1:3000/auth/oidc/callback http://localhost:3000/auth/oidc/callback"
SIM_IDP_SCOPES="openid profile email groups federated:id"
# Dex 的固定版本；commit 用來確認抓到的原始碼就是這個版本。
SIM_IDP_DEX_VERSION=v2.43.1
SIM_IDP_DEX_COMMIT=6e602d3315ea09d0cdeef6b51e61f2fd4ae52502
