# 開發與測試環境的連線設定（唯一來源）。build.sh、測試、工具、後端都讀這個檔。
# 密碼只在本機開發資料庫有效，不是真實機密。
SGN_PG_ADMIN_URL=postgres://das_dev:das_dev@127.0.0.1:5432/postgres
SGN_PG_HOST=127.0.0.1
SGN_PG_PORT=5432
# 資料庫：資料庫測試、端對端測試各用一個，互不干擾；效能比較用的另一個（不在執行路徑）。
SGN_DB_TEST=sgn_test
SGN_DB_E2E=sgn_e2e
SGN_DB_BENCH=sgn_bench
# 角色（命名依 docs/contract/00-spine.md 第 1.1 節）：owner 擁有物件（NOLOGIN）；其餘各自只能執行自己的 schema 的 function。
SGN_ROLE_OWNER=sgn_owner
SGN_ROLE_APP=sgn_app
SGN_ROLE_SYNC=sgn_sync
SGN_ROLE_JOB=sgn_job
# 只裝在測試資料庫：架構 (c) 的驗證服務（比較用，見 db/testing/）。
SGN_ROLE_TEST_VERIFIER=sgn_test_verifier
SGN_ROLE_PASSWORD_PREFIX=dev-pass-
# WebAuthn 的 relying party。頁面與後端分開來源（裁決 D68）：
#   SGN_RP_ORIGIN   後端（只回 JSON；身分提供者登記的回呼網址在這裡）
#   SGN_WEB_ORIGIN  頁面（獨立的靜態伺服器，web/server.mjs）；WebAuthn 的 origin 是它
SGN_RP_ID=localhost
SGN_RP_ORIGIN=http://localhost:3000
SGN_WEB_ORIGIN=http://localhost:3001
# 開發與驗收環境的第一位通行金鑰登記人（裁決 D65；db/tools/bootstrap-registrar.mjs 在建置時由資料庫擁有者建立）
SGN_SEED_REGISTRAR=p30
# 驗證服務（架構 c，只在測試）
SGN_TEST_VERIFIER_PORT=3901
# 通知信的寄件人（裁決 D76：通知經 mail port 的 SMTP adapter 寄出；開發環境寄到 sim/mail 的 Mailpit，位址在 sim/mail/service.env）
SGN_MAIL_FROM=no-reply@sim.example
