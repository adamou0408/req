# 探針的連線設定（唯一來源）。build.sh、測試、工具都讀這個檔。
# 密碼只在本機探針有效，不是真實機密。
PROBE_PG_ADMIN_URL=postgres://das_dev:das_dev@127.0.0.1:5432/postgres
PROBE_PG_HOST=127.0.0.1
PROBE_PG_PORT=5432
PROBE_DB=sgn_probe
PROBE_BENCH_DB=sgn_probe_bench
# 角色：owner 擁有物件（NOLOGIN）；其餘各自只能執行自己的 schema 的 function。
PROBE_ROLE_OWNER=sgn_probe_owner
PROBE_ROLE_APP=sgn_probe_app
PROBE_ROLE_VERIFIER=sgn_probe_verifier
PROBE_ROLE_SYNC=sgn_probe_sync
PROBE_ROLE_ANCHOR=sgn_probe_anchor
PROBE_ROLE_PASSWORD_PREFIX=probe-pass-
# 外部摘要（錨點）檔：放在資料庫以外。
PROBE_ANCHOR_FILE=/home/user/req/probe/db/.run/anchors.jsonl
# WebAuthn 的 relying party
PROBE_RP_ID=localhost
PROBE_RP_ORIGIN=http://localhost:3000
# 驗證服務（架構 c）
PROBE_VERIFIER_PORT=3901
